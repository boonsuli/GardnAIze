# Copy to .env locally; never commit real credentials.
POSTGRES_DB=gardnaize
POSTGRES_USER=gardnaize
POSTGRES_PASSWORD=change-me-locally
GEMINI_API_KEY=
# Docker Compose reads DB_PASSWORD (not POSTGRES_PASSWORD).
DB_PASSWORD=change-me-locally
# Optional local host ports for compose.local.yaml
FRONTEND_PORT=8080
BACKEND_PORT=8081
AI_PORT=8000
DB_PORT=5432
VISION_ENABLED=false
