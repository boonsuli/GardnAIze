# GardnAIze — example environment configuration.
# Copy this file to .env or .env.local and adjust values for your environment.
# Never commit actual passwords, API keys, or other secrets.
# Docker Compose loads .env by default; use --env-file .env.local to select .env.local.
# Shell-exported variables can override values from the selected environment file.

# Name of the main PostgreSQL application database created on first initialization.
POSTGRES_DB=gardnaize

# PostgreSQL role created when the database volume is first initialized.
POSTGRES_USER=gardnaize

# PostgreSQL image initialization password; compose.yaml uses DB_PASSWORD instead.
# Keep this placeholder consistent with DB_PASSWORD if using it outside compose.yaml.
POSTGRES_PASSWORD=password2define

# Google Gemini API key for the AI service; leave empty when not using Gemini.
GEMINI_API_KEY=

# PostgreSQL username used by GDAI-BACK.
DB_USER=gardnaize

# Shared PostgreSQL password used by Docker Compose for PostgreSQL, GDAI-BACK,
# ML database initialization, and Flyway migrations.
# Changing this value does not reset the password in an existing PostgreSQL volume.
DB_PASSWORD=password2define

# Host port exposing the application PostgreSQL database in compose.local.yaml.
DB_PORT=5432

# Logical PostgreSQL database used by ML ingestion and horticulture pipelines.
ML_DB_NAME=gardnaize_ml

# PostgreSQL host reachable from scripts running directly on the local machine or WSL2.
# Docker-to-Docker connections should use the service hostname "postgres" instead.
ML_DB_HOST=127.0.0.1

# Additional host port exposing the same PostgreSQL server for ML tools in compose.ml.yaml.
ML_DB_PORT=5433

# SQLAlchemy/psycopg connection URL for Python ML scripts running on the host or WSL2.
# Replace the password placeholder and URL-encode any special password characters.
# This value is not automatically interpolated from DB_PASSWORD by Python or Compose.
# Load the selected .env file into the Python process before running ingestion scripts.
GARDNAIZE_ML_DATABASE_URL=postgresql+psycopg://gardnaize:password2define@127.0.0.1:5433/gardnaize_ml

# Local frontend HTTP port exposed by compose.local.yaml.
FRONTEND_PORT=8080

# Local GDAI-BACK HTTP port exposed by compose.yaml.
BACKEND_PORT=8081

# Local AI service HTTP port exposed by compose.yaml.
AI_PORT=8000

# Enable or disable the GDAI-VISION integration; false avoids external Gemini calls.
VISION_ENABLED=false
